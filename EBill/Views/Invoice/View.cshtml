@model EBill.Models.Invoice
@{
    var company = ViewData["Company"] as EBill.Models.Company;
    var customer = Model.Customer!;
    var tax = Model.Taxes.FirstOrDefault();
    var subtotal = Model.Products.Sum(p => p.TotalAmount);
    var grandTotal = (tax is null ? subtotal : subtotal + tax.TotalTax) + Model.AdditionalCost;
    var amountPaidDisplay = Model.AmountPaid > 0 ? Model.AmountPaid : grandTotal;
    bool isReadOnly = ViewData["ReadOnly"] as bool? ?? false;
    Guid? accountingLinkId = ViewData["AccountingLinkId"] as Guid?;
    int? previousInvoiceId = ViewData["PreviousInvoiceId"] as int?;
    int? nextInvoiceId = ViewData["NextInvoiceId"] as int?;
    bool hasTax = tax is not null && tax.TotalTax > 0;
    string invoiceHeading = hasTax ? "Tax Invoice" : "Invoice";
    // Same colours as the status badge on the Invoices list; "Pending" reads as
    // "Not Paid" here since this page is about whether this bill has been settled.
    var paymentStatusText = Model.PaymentStatus switch
    {
        EBill.Models.PaymentStatus.Paid => "Paid",
        EBill.Models.PaymentStatus.PartiallyPaid => "Partially Paid",
        EBill.Models.PaymentStatus.Overdue => "Overdue",
        _ => "Not Paid",
    };
    var paymentStatusColor = Model.PaymentStatus switch
    {
        EBill.Models.PaymentStatus.Paid => "var(--brand-green)",
        EBill.Models.PaymentStatus.PartiallyPaid => "var(--brand-orange)",
        EBill.Models.PaymentStatus.Overdue => "#c0392b",
        _ => "#8a8a8a",
    };
    ViewData["Title"] = invoiceHeading;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div class="page-heading">
        <span class="icon-badge icon-badge--green">&#128196;</span>
        <div>
            <h1 class="mb-0">@invoiceHeading</h1>
            <p class="text-muted mb-0">Invoice @Model.DisplayBillNumber</p>
        </div>
    </div>
    <div class="d-flex gap-3 invoice-nav-links mt-1 no-print">
        @if (previousInvoiceId.HasValue)
        {
            @if (isReadOnly)
            {
                <a asp-controller="Accounting" asp-action="Invoice" asp-route-id="@accountingLinkId" asp-route-invoiceId="@previousInvoiceId" class="invoice-nav-link">&larr; Previous</a>
            }
            else
            {
                <a asp-controller="Invoice" asp-action="View" asp-route-id="@previousInvoiceId" class="invoice-nav-link">&larr; Previous</a>
            }
        }
        else
        {
            <span class="invoice-nav-link invoice-nav-link--disabled">&larr; Previous</span>
        }
        @if (nextInvoiceId.HasValue)
        {
            @if (isReadOnly)
            {
                <a asp-controller="Accounting" asp-action="Invoice" asp-route-id="@accountingLinkId" asp-route-invoiceId="@nextInvoiceId" class="invoice-nav-link">Next &rarr;</a>
            }
            else
            {
                <a asp-controller="Invoice" asp-action="View" asp-route-id="@nextInvoiceId" class="invoice-nav-link">Next &rarr;</a>
            }
        }
        else
        {
            <span class="invoice-nav-link invoice-nav-link--disabled">Next &rarr;</span>
        }
    </div>
</div>

<div class="form-card mt-3">
    <div class="d-flex justify-content-between align-items-start gap-3 invoice-top-row">
        <div class="invoice-logo-wrap">
            @if (company is not null && !string.IsNullOrWhiteSpace(company.LogoPath))
            {
                <img src="@Url.Content(company.LogoPath)" alt="@company.CompanyName logo" style="max-height: 90px; max-width: 100%; object-fit: contain;" />
            }
        </div>
        <div class="text-end invoice-meta-wrap">
            <h5 class="mb-1">Invoice @Model.DisplayBillNumber</h5>
            <p class="mb-0 text-muted">Invoice Date: @Model.Date.ToString("dd MMM yyyy")</p>
            <span id="paymentStatusBadge" class="badge mt-2" style="background-color: @paymentStatusColor; font-size: 0.85rem; -webkit-print-color-adjust: exact; print-color-adjust: exact;">@paymentStatusText</span>
        </div>
    </div>

    <div class="row mb-4 gy-4 mt-1">
        <div class="col-md-6">
            @if (company is not null)
            {
                <h5 style="color: var(--brand-green-dark);">@company.CompanyName</h5>
                <p class="mb-0 text-muted">@company.Address</p>
                <p class="mb-0 text-muted">@company.District, @company.State, @company.Country - @company.Pincode</p>
                @if (!string.IsNullOrWhiteSpace(company.PhoneNumber))
                {
                    <p class="mb-0 text-muted">Phone: @company.PhoneNumber</p>
                }
                <p class="mb-0 text-muted">GSTIN: @company.Gstin</p>
            }
        </div>
        <div class="col-md-6 text-md-end">
            <h6 class="text-uppercase fw-bold" style="color: var(--brand-orange-dark);">Bill To</h6>
            <p class="mb-0 fw-semibold">@customer.Name (@customer.CustomerNumber)</p>
            @if (!string.IsNullOrWhiteSpace(customer.Address))
            {
                <p class="mb-0 text-muted">@customer.Address</p>
            }
            @if (!string.IsNullOrWhiteSpace(customer.PhoneNumber))
            {
                <p class="mb-0 text-muted">Phone: @customer.PhoneNumber</p>
            }
            @if (!string.IsNullOrWhiteSpace(customer.Gstin))
            {
                <p class="mb-0 text-muted">GSTIN: @customer.Gstin</p>
            }
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle invoice-items-table">
            <thead>
                <tr style="background-color: var(--brand-green-light);">
                    <th>#</th>
                    <th>Description</th>
                    <th>HSN/SAC</th>
                    <th class="text-end">Qty</th>
                    <th>Qty Type</th>
                    <th class="text-end">Rate (&#8377;)</th>
                    <th class="text-end">Discount (&#8377;)</th>
                    <th class="text-end">Tax</th>
                    <th class="text-end">Amount (&#8377;)</th>
                </tr>
            </thead>
            <tbody>
                @{ var rowNum = 1; }
                @foreach (var product in Model.Products.OrderBy(p => p.Id))
                {
                    <tr>
                        <td>@rowNum</td>
                        <td>@product.Description</td>
                        <td>@product.HsnSac</td>
                        <td class="text-end">@product.Qty</td>
                        <td>@product.QtyType</td>
                        <td class="text-end">@MoneyFormat.Format(product.Rate)</td>
                        <td class="text-end">@MoneyFormat.Format(product.Discount)</td>
                        <td class="text-end">@((int)product.TaxRate)%</td>
                        <td class="text-end">@MoneyFormat.Format(product.TotalAmount)</td>
                    </tr>
                    rowNum++;
                }
                @if (!Model.Products.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-3">No line items added yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row justify-content-end">
        <div class="col-md-6">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr>
                        <td>Subtotal</td>
                        <td class="text-end">&#8377; @MoneyFormat.Format(subtotal)</td>
                    </tr>
                    @if (tax is not null)
                    {
                        <tr>
                            <td>CGST</td>
                            <td class="text-end">&#8377; @MoneyFormat.Format(tax.Cgst)</td>
                        </tr>
                        <tr>
                            <td>SGST</td>
                            <td class="text-end">&#8377; @MoneyFormat.Format(tax.Sgst)</td>
                        </tr>
                    }
                    @if (Model.AdditionalCost > 0)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(Model.AdditionalCostLabel) ? "Additional Cost" : Model.AdditionalCostLabel)</td>
                            <td class="text-end">&#8377; @MoneyFormat.Format(Model.AdditionalCost)</td>
                        </tr>
                    }
                    <tr class="fw-bold border-top">
                        <td>Grand Total</td>
                        <td class="text-end">&#8377; @MoneyFormat.Format(grandTotal)</td>
                    </tr>
                    <tr>
                        <td class="align-middle">Amount Paid</td>
                        <td class="text-end">
                            @if (isReadOnly)
                            {
                                <span>&#8377; @MoneyFormat.Format(amountPaidDisplay)</span>
                            }
                            else
                            {
                                <div class="d-flex justify-content-end align-items-center gap-2 no-print amount-paid-controls">
                                    <span>&#8377;</span>
                                    <input type="number" id="amountPaidInput" class="form-control form-control-sm text-end" step="0.01" min="0" value="@amountPaidDisplay.ToString("0.00")" />
                                    <button type="button" id="markPaidBtn" class="btn btn-sm btn-primary">Paid</button>
                                </div>
                                <span class="print-only">&#8377; @MoneyFormat.Format(amountPaidDisplay)</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <p class="text-muted mb-1">Amount in words:</p>
        <p class="fw-semibold">@NumberToWords.ConvertAmountToWords(grandTotal)</p>
    </div>

    @if (ViewData["InvoiceFootprint"] is string footprintHtml && !string.IsNullOrWhiteSpace(footprintHtml))
    {
        @* Sanitized on save (SettingsController.SanitizeFootprint), so safe to render raw. *@
        <div class="mt-4 d-flex justify-content-end">
            <div class="invoice-footprint text-end">@Html.Raw(footprintHtml)</div>
        </div>
    }

    <div class="mt-4 pt-3 border-top">
        <p class="mb-2 fw-semibold" style="color: #d91f1f">No Return</p>
        <p class="mb-0 text-muted">
            <strong>Declaration:</strong> We declare that this Invoice shows the actual price of the goods described
            and that all particulars are true and correct.
        </p>
    </div>

    <div class="mt-3 text-center text-muted">
        <small>This is a computer generated invoice.</small>
    </div>
</div>

@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2 mt-3 no-print invoice-actions">
    @if (isReadOnly)
    {
        <a asp-controller="Accounting" asp-action="Index" asp-route-id="@accountingLinkId" class="btn btn-outline-secondary">&larr; Back to Report</a>
        <button type="button" id="printBtn" class="btn btn-outline-secondary">Print</button>
    }
    else
    {
        <a asp-controller="Product" asp-action="Index" asp-route-invoiceId="@Model.Id" class="btn btn-outline-secondary">Back to Products</a>
        <button type="button" id="printBtn" class="btn btn-outline-secondary">Print</button>
        <button type="button" id="emailBtn" class="btn btn-primary">@(Model.Emailed ? "Re-send Email" : "Email")</button>
        <span id="emailedNote" class="text-muted small text-center text-sm-start @(Model.Emailed ? "" : "d-none")">&#10003; Emailed</span>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const invoiceId = @Model.Id;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const printBtn = document.getElementById('printBtn');
            const markPaidBtn = document.getElementById('markPaidBtn');
            const emailBtn = document.getElementById('emailBtn');

            if (printBtn) {
                printBtn.addEventListener('click', function () {
                    window.print();
                });
            }

            if (markPaidBtn) {
                markPaidBtn.addEventListener('click', async function () {
                    const formData = new FormData();
                    formData.append('id', invoiceId);
                    formData.append('amountPaid', document.getElementById('amountPaidInput').value);
                    formData.append('__RequestVerificationToken', token);

                    const response = await fetch('/Invoice/UpdatePayment', { method: 'POST', body: formData });
                    if (response.ok) {
                        // UpdatePayment marks the invoice Paid - reflect that without a reload.
                        const badge = document.getElementById('paymentStatusBadge');
                        badge.textContent = 'Paid';
                        badge.style.backgroundColor = 'var(--brand-green)';
                    }
                });
            }

            if (emailBtn) {
                emailBtn.addEventListener('click', async function () {
                    const btn = this;
                    const formData = new FormData();
                    formData.append('id', invoiceId);
                    formData.append('__RequestVerificationToken', token);

                    const response = await fetch('/Invoice/MarkEmailed', { method: 'POST', body: formData });
                    if (response.ok) {
                        btn.textContent = 'Re-send Email';
                        document.getElementById('emailedNote').classList.remove('d-none');
                    }
                });
            }
        })();
    </script>
}
