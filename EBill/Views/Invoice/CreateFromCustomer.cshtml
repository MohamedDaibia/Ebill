@model EBill.Models.CreateInvoiceFromDispatchViewModel
@{
    ViewData["Title"] = "Create Invoice";
    var customer = Model.Customer;
    var pendingItems = Model.Items.Where(i => !i.IsInvoiced).ToList();
    var hasInvoicedItems = Model.Items.Any(i => i.IsInvoiced);
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div class="page-heading">
        <span class="icon-badge icon-badge--orange">&#128230;</span>
        <div>
            <h1 class="mb-0">Create Invoice</h1>
            <p class="text-muted mb-0">Items Stock Management dispatched to @customer.Name.</p>
        </div>
    </div>
    <div class="d-flex gap-2 mt-1">
        <a asp-controller="Invoice" asp-action="Index" asp-route-customerId="@customer.Id" class="btn btn-outline-secondary btn-sm">Show Invoices</a>
        <a asp-controller="Customers" asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Customers</a>
    </div>
</div>

@if (TempData["DispatchError"] is string dispatchError)
{
    <div class="alert alert-danger mt-3 mb-0">@dispatchError</div>
}

@if (Model.DateWasAdjusted)
{
    <div class="alert alert-warning mt-3 mb-0">Today's and future dates aren't available yet - showing @Model.SelectedDate.ToString("dd MMM yyyy") instead.</div>
}

<div class="form-card mt-3">
    <div class="row g-3 customer-details-row">
        <div class="col-6 col-md-3">
            <div class="text-muted small text-uppercase">Customer Name</div>
            <div class="fw-semibold text-truncate">@customer.Name</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="text-muted small text-uppercase">Phone Number</div>
            <div class="fw-semibold text-truncate">@customer.PhoneNumber</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="text-muted small text-uppercase">GSTIN</div>
            <div class="fw-semibold text-truncate">@(string.IsNullOrWhiteSpace(customer.Gstin) ? "-" : customer.Gstin)</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="text-muted small text-uppercase">Address</div>
            <div class="fw-semibold text-truncate">@(string.IsNullOrWhiteSpace(customer.Address) ? "-" : customer.Address)</div>
        </div>
    </div>
</div>

<div class="form-card mt-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div class="d-flex align-items-center flex-wrap gap-3">
            <h5 class="mb-0">Dispatched Items</h5>
            <a asp-controller="Invoice" asp-action="InvoicedItems" asp-route-customerId="@customer.Id" asp-route-date="@Model.SelectedDate.ToString("yyyy-MM-dd")">Invoice Items</a>
        </div>
        <form asp-controller="Invoice" asp-action="CreateFromCustomer" method="get" class="d-flex align-items-center gap-2">
            <input type="hidden" name="customerId" value="@customer.Id" />
            <label for="dispatchDate" class="form-label mb-0 text-muted small text-uppercase">Date</label>
            <input type="date" id="dispatchDate" name="date" class="form-control form-control-sm"
                   value="@Model.SelectedDate.ToString("yyyy-MM-dd")" max="@Model.MaxSelectableDate.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-outline-secondary btn-sm">Go</button>
        </form>
    </div>

    @if (!pendingItems.Any())
    {
        <p class="text-muted text-center py-4 mb-0">
            @if (hasInvoicedItems)
            {
                <text>All items dispatched to this customer on @Model.SelectedDate.ToString("dd MMM yyyy") have already been invoiced - see <a asp-controller="Invoice" asp-action="InvoicedItems" asp-route-customerId="@customer.Id" asp-route-date="@Model.SelectedDate.ToString("yyyy-MM-dd")">Invoice Items</a>.</text>
            }
            else
            {
                <text>No items dispatched to this customer on @Model.SelectedDate.ToString("dd MMM yyyy").</text>
            }
        </p>
    }
    else
    {
        <form asp-controller="Invoice" asp-action="CreateFromDispatch" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="customerId" value="@customer.Id" />
            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />

            <div class="table-responsive">
                <table class="table align-middle" id="dispatchItemsTable">
                    <thead>
                        <tr style="background-color: var(--brand-green-light);">
                            <th>#</th>
                            <th>Description</th>
                            <th>HSN/SAC</th>
                            <th class="text-end">Qty</th>
                            <th class="d-none d-md-table-cell">Qty Type</th>
                            <th class="d-none d-md-table-cell">Dispatched Date</th>
                            <th class="text-end">Cost/Qty (&#8377;)</th>
                            <th class="text-end">Total Cost (&#8377;)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var rowNumber = 0; }
                        @foreach (var item in pendingItems)
                        {
                            var pendingIndex = rowNumber;
                            rowNumber++;
                            <tr>
                                <td>@rowNumber</td>
                                <td>@item.Description</td>
                                <td>
                                    <input type="hidden" name="items[@pendingIndex].DispatchProductId" value="@item.DispatchProductId" />
                                    <input type="hidden" name="items[@pendingIndex].Description" value="@item.Description" />
                                    <input type="hidden" name="items[@pendingIndex].Qty" value="@item.Qty.ToString("0.####")" />
                                    <input type="hidden" name="items[@pendingIndex].QtyType" value="@item.QtyType" />
                                    <input type="hidden" name="items[@pendingIndex].DispatchedDate" value="@item.DispatchedDate.ToString("yyyy-MM-dd")" />
                                    <input type="text" maxlength="20"
                                           class="form-control form-control-sm"
                                           style="max-width: 100px;"
                                           name="items[@pendingIndex].HsnSac" value="@item.HsnSac"
                                           placeholder="HSN/SAC" />
                                </td>
                                <td class="text-end">
                                    @item.Qty.ToString("0.##")
                                    <div class="d-md-none text-muted small">@item.QtyType</div>
                                </td>
                                <td class="d-none d-md-table-cell">@item.QtyType</td>
                                <td class="d-none d-md-table-cell">@item.DispatchedDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <input type="number" step="0.01" min="0"
                                           class="form-control form-control-sm text-end cost-input no-spinner"
                                           style="max-width: 110px; display: inline-block;"
                                           name="items[@pendingIndex].Rate" value="@(item.Rate > 0 ? item.Rate.ToString("0.00") : "")"
                                           placeholder="0.00"
                                           data-qty="@item.Qty.ToString("0.####")" data-row="@pendingIndex" />
                                </td>
                                <td class="text-end">
                                    <span class="total-cost-value fw-semibold" data-row="@pendingIndex">&#8377; @item.Amount.ToString("0.00")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-sm-end align-items-sm-center mt-2">
                <button type="button" id="calculateAmountBtn" class="btn btn-primary">Calculate Amount</button>
            </div>

            <div id="amountSummary" class="form-card form-card--orange mt-3 d-none">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">Total Amount</span>
                    <span class="fs-5 fw-bold" id="amountSummaryValue">&#8377; 0.00</span>
                </div>
            </div>

            <div class="d-flex justify-content-sm-end mt-4">
                <button type="submit" class="btn btn-outline-orange">Create Invoice</button>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const dateInput = document.getElementById('dispatchDate');
            if (dateInput) {
                dateInput.addEventListener('change', function () {
                    dateInput.form.submit();
                });
            }

            function formatMoney(n) {
                return Number(n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            const amountSummary = document.getElementById('amountSummary');

            // Recalculates one row's Total Cost as its Cost/Qty input changes, and
            // hides the (now stale) overall total until Calculate Amount is pressed
            // again.
            document.querySelectorAll('.cost-input').forEach(function (input) {
                input.addEventListener('input', function () {
                    const row = input.dataset.row;
                    const qty = parseFloat(input.dataset.qty) || 0;
                    const rate = parseFloat(input.value) || 0;
                    const cell = document.querySelector('.total-cost-value[data-row="' + row + '"]');
                    if (cell) {
                        cell.textContent = '₹ ' + formatMoney(qty * rate);
                    }
                    if (amountSummary) {
                        amountSummary.classList.add('d-none');
                    }
                });
            });

            // A Cost/Qty left blank (it shows the 0.00 placeholder) is posted as 0
            // rather than as an empty string the decimal binder would reject.
            const dispatchForm = document.querySelector('#dispatchItemsTable') && document.querySelector('#dispatchItemsTable').closest('form');
            if (dispatchForm) {
                dispatchForm.addEventListener('submit', function () {
                    dispatchForm.querySelectorAll('.cost-input').forEach(function (input) {
                        if (input.value === '') input.value = '0';
                    });
                });
            }

            const calculateBtn = document.getElementById('calculateAmountBtn');
            if (calculateBtn) {
                calculateBtn.addEventListener('click', function () {
                    const inputs = document.querySelectorAll('#dispatchItemsTable .cost-input');
                    let total = 0;
                    inputs.forEach(function (input) {
                        const qty = parseFloat(input.dataset.qty) || 0;
                        const rate = parseFloat(input.value) || 0;
                        total += qty * rate;
                    });

                    document.getElementById('amountSummaryValue').textContent = '₹ ' + formatMoney(total);
                    amountSummary.classList.remove('d-none');
                });
            }
        })();
    </script>
}
