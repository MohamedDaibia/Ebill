@using EBill.Models
@model List<EBill.Models.Invoice>
@{
    ViewData["Title"] = "Invoices";
    int? selectedDays = ViewData["SelectedDays"] as int?;
    var presetDays = new[] { 1, 7, 30, 90 };
    int? customerId = ViewData["CustomerId"] as int?;
    var customerName = ViewData["CustomerName"] as string;
    var customValue = (selectedDays.HasValue && !presetDays.Contains(selectedDays.Value)) ? selectedDays : null;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div class="page-heading">
        <span class="icon-badge icon-badge--green">&#128203;</span>
        <div>
            <h1 class="mb-0">Invoices</h1>
                @if (customerId.HasValue)
            {
                <p class="text-muted mb-0">Invoices for <strong>@customerName</strong>. <a asp-controller="Invoice" asp-action="Index">Show all customers</a>@if (User.IsInRole(UserRoles.Admin)) { <text> &middot; <a asp-controller="Customers" asp-action="Index">Back to Customers</a></text> }</p>
            }
            else
            {
                <p class="text-muted mb-0">Browse your invoices, filtered by date.</p>
            }
        </div>
    </div>
    @if (User.IsInRole(UserRoles.Admin))
    {
        <a asp-controller="Invoice" asp-action="Create" class="btn btn-outline-secondary btn-sm mt-1">+ New Invoice</a>
    }
</div>

<div class="form-card mt-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3 invoice-filter-bar">
        <a asp-action="Index" asp-route-customerId="@customerId" class="btn btn-sm @(selectedDays is null ? "btn-primary" : "btn-outline-secondary")">All Time</a>
        <a asp-action="Index" asp-route-customerId="@customerId" asp-route-days="1" class="btn btn-sm @(selectedDays == 1 ? "btn-primary" : "btn-outline-secondary")">Today</a>
        <a asp-action="Index" asp-route-customerId="@customerId" asp-route-days="7" class="btn btn-sm @(selectedDays == 7 ? "btn-primary" : "btn-outline-secondary")">Last 7 Days</a>
        <a asp-action="Index" asp-route-customerId="@customerId" asp-route-days="30" class="btn btn-sm @(selectedDays == 30 ? "btn-primary" : "btn-outline-secondary")">Last 30 Days</a>
        <a asp-action="Index" asp-route-customerId="@customerId" asp-route-days="90" class="btn btn-sm @(selectedDays == 90 ? "btn-primary" : "btn-outline-secondary")">Last 90 Days</a>

        <form asp-action="Index" method="get" class="d-flex align-items-center gap-2 ms-sm-auto">
            <label for="customDays" class="text-muted small mb-0">Last</label>
            @if (customerId.HasValue)
            {
                <input type="hidden" name="customerId" value="@customerId" />
            }
            <input type="number" id="customDays" name="days" min="1" class="form-control form-control-sm" style="width: 80px;" placeholder="N" value="@customValue" />
            <label for="customDays" class="text-muted small mb-0">days</label>
            <button type="submit" class="btn btn-sm btn-outline-secondary">Go</button>
        </form>

            @if (User.IsInRole(UserRoles.Admin))
            {
            <form asp-controller="Invoice" asp-action="Accounting" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="days" value="@selectedDays" />
                <button type="submit" class="btn btn-sm btn-primary" title="Get a shareable report link for @(selectedDays is null ? "all invoices" : $"the last {selectedDays} day(s)")">Accounting</button>
            </form>
            }
    </div>

    <div class="table-responsive">
        <table class="table align-middle invoice-list-table">
            <thead>
                <tr style="background-color: var(--brand-green-light);">
                    <th>Bill No.</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th class="text-end">Amount (&#8377;)</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No invoices found for this period.</td>
                    </tr>
                }
                else
                {
                    @foreach (var invoice in Model)
                    {
                        var subtotal = invoice.Products.Sum(p => p.TotalAmount);
                        var tax = invoice.Taxes.FirstOrDefault();
                        var grandTotal = (tax is null ? subtotal : subtotal + tax.TotalTax) + invoice.AdditionalCost;
                        var statusColor = invoice.PaymentStatus switch
                        {
                            EBill.Models.PaymentStatus.Paid => "var(--brand-green)",
                            EBill.Models.PaymentStatus.PartiallyPaid => "var(--brand-orange)",
                            EBill.Models.PaymentStatus.Overdue => "#c0392b",
                            _ => "#8a8a8a",
                        };
                        <tr>
                            <td>@invoice.DisplayBillNumber</td>
                            <td>@invoice.Customer?.Name</td>
                            <td>@invoice.Date.ToString("dd MMM yyyy")</td>
                            <td class="text-end">&#8377; @MoneyFormat.Format(grandTotal)</td>
                            <td>
                                <span class="badge" style="background-color: @statusColor;">@invoice.PaymentStatus</span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-controller="Invoice" asp-action="View" asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                    @if (User.IsInRole(UserRoles.Admin))
                                    {
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteInvoiceModal" data-invoice-id="@invoice.Id" data-bill-number="@invoice.DisplayBillNumber" title="Delete invoice">Delete</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Invoice Modal -->
<div class="modal fade" id="deleteInvoiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteInvoiceForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Delete Invoice</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Are you sure you want to delete invoice <strong id="deleteInvoiceBillNumber"></strong>? This will permanently remove its line items and tax details. This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete Invoice</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const deleteModal = document.getElementById('deleteInvoiceModal');
            const deleteForm = document.getElementById('deleteInvoiceForm');
            const deleteBillNumber = document.getElementById('deleteInvoiceBillNumber');

            deleteModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const invoiceId = button.getAttribute('data-invoice-id');
                const billNumber = button.getAttribute('data-bill-number');

                deleteBillNumber.textContent = billNumber;
                deleteForm.action = '/Invoice/Delete/' + invoiceId + window.location.search;
            });
        })();
    </script>
}
