@model EBill.Models.Company
@{
    ViewData["Title"] = "EBill";
}

<div class="row">
    <div class="col-lg-8">
        <div class="page-heading">
            <span class="icon-badge icon-badge--green">&#127970;</span>
            <div>
                <h1 class="mb-0">Company Registration</h1>
                <p class="text-muted mb-0">Enter your company details. These will appear on every invoice you generate.</p>
            </div>
        </div>
        <div class="form-card mt-3">
            @await Html.PartialAsync("_CompanyRegisterForm", Model)
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
