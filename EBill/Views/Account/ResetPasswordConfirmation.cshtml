@{
    ViewData["Title"] = "Password Reset";
}

<div class="row">
    <div class="col-md-5">
        <div class="page-heading">
            <span class="icon-badge icon-badge--green">&#9989;</span>
            <div>
                <h1 class="mb-0">Password Reset</h1>
            </div>
        </div>
        <div class="alert alert-success mt-3">
            Your password has been reset. You can now log in with your new password.
        </div>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-2">Go to login</a>
    </div>
</div>
