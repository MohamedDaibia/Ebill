@{
    ViewData["Title"] = "Check Your Email";
}

<div class="row">
    <div class="col-md-5">
        <div class="page-heading">
            <span class="icon-badge icon-badge--green">&#9993;</span>
            <div>
                <h1 class="mb-0">Check Your Email</h1>
            </div>
        </div>
        <div class="alert alert-success mt-3">
            If an account exists for that email address, we've sent a link to reset your password.
            The link expires in 1 hour.
        </div>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary mt-2">Back to login</a>
    </div>
</div>
