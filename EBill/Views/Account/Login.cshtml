@model EBill.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="row">
    <div class="col-md-5">
        <div class="page-heading">
            <span class="icon-badge icon-badge--orange">&#128272;</span>
            <div>
                <h1 class="mb-0">Login</h1>
                <p class="text-muted mb-0">Sign in to manage your invoices.</p>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.ReturnUrl))
        {
            <div class="alert alert-info" role="alert">
                Sign in to connect your Ebill account.
            </div>
        }
        <div class="form-card form-card--orange mt-3">
            @await Html.PartialAsync("_LoginForm", Model)
            <p class="mt-3 mb-0">
                New company?
                <a asp-controller="Company" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" asp-route-stockCompanyId="@Model.StockCompanyId">Register here</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
