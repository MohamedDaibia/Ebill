@model EBill.Models.Settings
@{
    ViewData["Title"] = "Settings";
}

<div class="row">
    <div class="col-lg-7">
        <div class="page-heading">
            <span class="icon-badge icon-badge--green">&#9881;&#65039;</span>
            <div>
                <h1 class="mb-0">Settings</h1>
                <p class="text-muted mb-0">Connections between this Ebill account and other apps.</p>
            </div>
        </div>

        <div class="form-card mt-3">
            <h2 class="h5 mb-3">Document Numbering</h2>
            <p class="text-muted small">
                Set the next number to hand out for each document type. Leave a field blank to leave that
                counter as it is. Each time a new document is created, the number shown here is used and then
                automatically moves up by one.
            </p>

            @if (TempData["NumberingSaved"] != null)
            {
                <div class="alert alert-success" role="alert">Numbering settings saved.</div>
            }
            @if (TempData["NumberingError"] != null)
            {
                <div class="alert alert-danger" role="alert">@TempData["NumberingError"]</div>
            }

            <form asp-controller="Settings" asp-action="UpdateNumbering" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <label for="nextInvoiceNumber" class="form-label">Start With Invoice Number</label>
                    <input type="number" min="1" class="form-control" id="nextInvoiceNumber"
                           name="nextInvoiceNumber" value="@Model.NextInvoiceNumber"
                           placeholder="Not set" />
                </div>
                <div class="col-md-4">
                    <label for="nextQuotationNumber" class="form-label">Start With Quotation Number</label>
                    <input type="number" min="1" class="form-control" id="nextQuotationNumber"
                           name="nextQuotationNumber" value="@Model.NextQuotationNumber"
                           placeholder="Not set" />
                </div>
                <div class="col-md-4">
                    <label for="nextPurchaseOrderNumber" class="form-label">Start With Purchase Order Number</label>
                    <input type="number" min="1" class="form-control" id="nextPurchaseOrderNumber"
                           name="nextPurchaseOrderNumber" value="@Model.NextPurchaseOrderNumber"
                           placeholder="Not set" />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Save Numbering</button>
                </div>
            </form>
        </div>

        <div class="form-card mt-3">
            <h2 class="h5 mb-3">Invoice Footprint</h2>
            <p class="text-muted small">
                The text printed at the bottom of every invoice - thank-you note, payment terms, bank
                details, legal lines. Write it once here and it appears on all invoices.
            </p>

            @if (TempData["FootprintSaved"] != null)
            {
                <div class="alert alert-success" role="alert">Invoice footprint saved.</div>
            }
            @if (TempData["FootprintError"] != null)
            {
                <div class="alert alert-danger" role="alert">@TempData["FootprintError"]</div>
            }

            <form asp-controller="Settings" asp-action="UpdateInvoiceFootprint" method="post" id="footprintForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="invoiceFootprint" id="invoiceFootprint" />

                <div class="footprint-toolbar d-flex flex-wrap align-items-center gap-1 border rounded-top p-2 bg-light" role="toolbar" aria-label="Text formatting">
                    <button type="button" class="btn btn-sm btn-outline-secondary fp-btn" data-cmd="undo" aria-label="Undo" title="Undo">&#8630;</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary fp-btn" data-cmd="redo" aria-label="Redo" title="Redo">&#8631;</button>
                    <span class="vr mx-1"></span>
                    <select class="form-select form-select-sm w-auto" id="fpSize" aria-label="Text size" title="Text size">
                        <option value="">Size</option>
                        <option value="0.8">Small</option>
                        <option value="1">Normal</option>
                        <option value="1.3">Large</option>
                        <option value="1.7">Huge</option>
                    </select>
                    <label class="btn btn-sm btn-outline-secondary mb-0 d-inline-flex align-items-center gap-1" title="Text color">
                        <span class="fw-bold" style="border-bottom: 3px solid #d91f1f; line-height: 1" id="fpColorSwatch">A</span>
                        <input type="color" id="fpColor" value="#d91f1f" aria-label="Text color" style="width: 22px; height: 22px; padding: 0; border: 0; background: none" />
                    </label>
                    <span class="vr mx-1"></span>
                    <button type="button" class="btn btn-sm btn-outline-secondary fp-btn fw-bold" data-cmd="bold" aria-label="Bold" title="Bold">B</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary fp-btn fst-italic" data-cmd="italic" aria-label="Italic" title="Italic">I</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary fp-btn text-decoration-underline" data-cmd="underline" aria-label="Underline" title="Underline">U</button>
                    <span class="vr mx-1"></span>
                    <button type="button" class="btn btn-sm btn-outline-secondary fp-btn" data-cmd="justifyLeft" aria-label="Align left" title="Align left">&#8676;</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary fp-btn" data-cmd="justifyCenter" aria-label="Align center" title="Align center">&#8596;</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary fp-btn" data-cmd="justifyRight" aria-label="Align right" title="Align right">&#8677;</button>
                    <span class="vr mx-1"></span>
                    <button type="button" class="btn btn-sm btn-outline-secondary fp-btn" data-cmd="insertUnorderedList" aria-label="Bulleted list" title="Bulleted list">&bull; List</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary fp-btn" data-cmd="insertOrderedList" aria-label="Numbered list" title="Numbered list">1. List</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary fp-btn" id="fpLink" aria-label="Insert link" title="Insert link">Link</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary fp-btn" data-cmd="removeFormat" aria-label="Clear formatting" title="Clear formatting">Clear</button>
                </div>

                <div id="footprintEditor" class="form-control rounded-top-0" contenteditable="true" role="textbox"
                     aria-multiline="true" aria-label="Invoice footprint text"
                     style="min-height: 180px; height: auto; overflow-wrap: anywhere;">@Html.Raw(Model.InvoiceFootprint)</div>

                <div class="d-flex justify-content-between small text-muted mt-1">
                    <span>Shown above &ldquo;This is a computer generated invoice.&rdquo; on every invoice.</span>
                    <span id="footprintCount">0 / 4000</span>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Save Footprint</button>
                </div>
            </form>
        </div>

        <div class="form-card mt-3">
            <h2 class="h5 mb-3">Stock Management</h2>

            @if (string.IsNullOrEmpty(Model.StockCompanyId))
            {
                <div class="alert alert-info mb-0" role="alert">
                    Not connected yet. Open Stock Management's Settings page and use
                    <strong>Sync Ebill</strong> to connect it to this Ebill account.
                </div>
            }
            else if (Model.IsSynced)
            {
                <div class="alert alert-success mb-0" role="alert">
                    <strong>Connected</strong> &middot; Stock Management company #@Model.StockCompanyId
                    <div class="small mt-1">Ebill can call Stock Management's API on this company's behalf.</div>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0" role="alert">
                    <strong>Linked, not fully connected</strong> &middot; Stock Management company #@Model.StockCompanyId
                    <div class="small mt-1">
                        Stock Management knows about this Ebill account, but hasn't finished handing Ebill
                        an API connection yet. Try <strong>Sync Ebill</strong> again from Stock Management's
                        Settings page.
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const editor = document.getElementById('footprintEditor');
            const hidden = document.getElementById('invoiceFootprint');
            const counter = document.getElementById('footprintCount');
            const form = document.getElementById('footprintForm');
            const max = 4000;

            function sync() {
                hidden.value = editor.innerHTML;
                counter.textContent = hidden.value.length + ' / ' + max;
                counter.classList.toggle('text-danger', hidden.value.length > max);
            }

            document.querySelectorAll('.fp-btn[data-cmd]').forEach(function (btn) {
                // mousedown + preventDefault keeps the text selection in the editor.
                btn.addEventListener('mousedown', function (e) { e.preventDefault(); });
                btn.addEventListener('click', function () {
                    editor.focus();
                    document.execCommand('styleWithCSS', false, false);
                    document.execCommand(btn.dataset.cmd, false, null);
                    sync();
                });
            });

            // Text size: execCommand's fontSize only knows 1-7, so apply the marker
            // size 7 and then swap those <font> tags for relative-size spans.
            const sizeSel = document.getElementById('fpSize');
            const sizeClass = { '0.8': 'fp-sm', '1.3': 'fp-lg', '1.7': 'fp-xl' };
            sizeSel.addEventListener('change', function () {
                const em = sizeSel.value;
                sizeSel.value = '';
                if (!em) { return; }
                editor.focus();
                document.execCommand('styleWithCSS', false, false);
                document.execCommand('fontSize', false, '7');
                editor.querySelectorAll('font[size="7"]').forEach(function (f) {
                    const span = document.createElement('span');
                    if (sizeClass[em]) { span.className = sizeClass[em]; }
                    while (f.firstChild) { span.appendChild(f.firstChild); }
                    f.replaceWith(span);
                });
                sync();
            });

            // Text color: remember the selection while the native picker is open.
            // styleWithCSS off => produces <font color="#rrggbb">, which survives saving.
            const colorInput = document.getElementById('fpColor');
            const swatch = document.getElementById('fpColorSwatch');
            let savedRange = null;
            colorInput.addEventListener('mousedown', function () {
                const sel = window.getSelection();
                savedRange = sel.rangeCount ? sel.getRangeAt(0).cloneRange() : null;
            });
            colorInput.addEventListener('input', function () {
                swatch.style.borderBottomColor = colorInput.value;
                editor.focus();
                if (savedRange) {
                    const sel = window.getSelection();
                    sel.removeAllRanges();
                    sel.addRange(savedRange);
                }
                document.execCommand('styleWithCSS', false, false);
                document.execCommand('foreColor', false, colorInput.value);
                sync();
            });

            const linkBtn = document.getElementById('fpLink');
            linkBtn.addEventListener('mousedown', function (e) { e.preventDefault(); });
            linkBtn.addEventListener('click', function () {
                const url = window.prompt('Link address (https://...)');
                if (!url || !/^(https?:\/\/|mailto:)/i.test(url)) { return; }
                editor.focus();
                document.execCommand('createLink', false, url);
                sync();
            });

            // Paste as plain text so pasted web/Word content can't drag in styles.
            editor.addEventListener('paste', function (e) {
                e.preventDefault();
                const text = (e.clipboardData || window.clipboardData).getData('text/plain');
                document.execCommand('insertText', false, text);
            });

            editor.addEventListener('input', sync);
            form.addEventListener('submit', function (e) {
                sync();
                if (hidden.value.length > max) {
                    e.preventDefault();
                    alert('The footer is too long. Please shorten it.');
                }
            });
            sync();
        })();
    </script>
}
