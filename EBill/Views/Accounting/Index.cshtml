@model List<EBill.Models.Invoice>
@{
    ViewData["Title"] = "Accounting Report";
    var fromDate = (DateTime)ViewData["FromDate"]!;
    var toDate = (DateTime)ViewData["ToDate"]!;
    var days = ViewData["Days"] as int?;
    var linkId = ViewData["LinkId"] as Guid?;
    string periodLabel = days switch
    {
        null => "All Time",
        1 => "Today",
        7 => "Last 7 Days",
        30 => "Last 30 Days",
        90 => "Last 90 Days",
        _ => $"Last {days} Days",
    };

    decimal InvoiceGrandTotal(EBill.Models.Invoice invoice)
    {
        var subtotal = invoice.Products.Sum(p => p.TotalAmount);
        var tax = invoice.Taxes.FirstOrDefault();
        return tax is null ? subtotal : subtotal + tax.TotalTax;
    }
}

<div class="page-heading">
    <span class="icon-badge icon-badge--orange">&#128179;</span>
    <div>
        <h1 class="mb-0">Accounting Report</h1>
        <p class="text-muted mb-0">@periodLabel &mdash; @fromDate.ToString("dd MMM yyyy") to @toDate.ToString("dd MMM yyyy")</p>
    </div>
</div>

<div class="form-card mt-3">
    <div class="table-responsive">
        <table class="table align-middle accounting-table">
            <thead>
                <tr style="background-color: var(--brand-orange-light);">
                    <th>Invoice #</th>
                    <th class="text-end">Amount (&#8377;)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">No invoices found for this period.</td>
                    </tr>
                }
                else
                {
                    @foreach (var invoice in Model)
                    {
                        <tr>
                            <td>@invoice.BillNumber</td>
                            <td class="text-end">&#8377; @MoneyFormat.Format(InvoiceGrandTotal(invoice))</td>
                            <td class="text-end">
                                <a asp-controller="Accounting" asp-action="Invoice" asp-route-id="@linkId" asp-route-invoiceId="@invoice.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.Any())
    {
        <div class="d-flex justify-content-end mt-3">
            <span class="text-muted me-3">Total:</span>
            <span class="fs-5 fw-bold">&#8377; @MoneyFormat.Format(Model.Sum(InvoiceGrandTotal))</span>
        </div>
    }
</div>

<div class="mt-3">
    <a asp-controller="Invoice" asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to Invoices</a>
</div>
