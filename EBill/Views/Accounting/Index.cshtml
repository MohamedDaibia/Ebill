@model List<EBill.Models.Invoice>
@{
    ViewData["Title"] = "Accounting Report";
    var fromDate = (DateTime)ViewData["FromDate"]!;
    var toDate = (DateTime)ViewData["ToDate"]!;
    var days = ViewData["Days"] as int?;
    var linkId = ViewData["LinkId"] as Guid?;
    string periodLabel = days switch
    {
        null => "All Time",
        1 => "Today",
        7 => "Last 7 Days",
        30 => "Last 30 Days",
        90 => "Last 90 Days",
        _ => $"Last {days} Days",
    };

    decimal InvoiceGrandTotal(EBill.Models.Invoice invoice)
    {
        var subtotal = invoice.Products.Sum(p => p.TotalAmount);
        var tax = invoice.Taxes.FirstOrDefault();
        return (tax is null ? subtotal : subtotal + tax.TotalTax) + invoice.AdditionalCost;
    }
}

<div class="page-heading">
    <span class="icon-badge icon-badge--orange">&#128179;</span>
    <div>
        <h1 class="mb-0">Accounting Report</h1>
        <p class="text-muted mb-0">@periodLabel &mdash; @fromDate.ToString("dd MMM yyyy") to @toDate.ToString("dd MMM yyyy")</p>
    </div>
</div>

<div class="form-card mt-3">
    <div class="table-responsive">
        <table class="table align-middle accounting-table">
            <thead>
                <tr style="background-color: var(--brand-orange-light);">
                    <th>Invoice #</th>
                    <th class="text-end">Amount (&#8377;)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">No invoices found for this period.</td>
                    </tr>
                }
                else
                {
                    @foreach (var invoice in Model)
                    {
                        <tr>
                            <td>@invoice.BillNumber</td>
                            <td class="text-end">&#8377; @MoneyFormat.Format(InvoiceGrandTotal(invoice))</td>
                            <td class="text-end">
                                <a asp-controller="Accounting" asp-action="Invoice" asp-route-id="@linkId" asp-route-invoiceId="@invoice.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.Any())
    {
        <div class="d-flex justify-content-end mt-3">
            <span class="text-muted me-3">Total:</span>
            <span class="fs-5 fw-bold">&#8377; @MoneyFormat.Format(Model.Sum(InvoiceGrandTotal))</span>
        </div>
    }

</div>

<div class="mt-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
    <a asp-controller="Invoice" asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to Invoices</a>

    @if (linkId is not null)
    {
        var reportUrl = Url.Action("Index", "Accounting", new { id = linkId }, Context.Request.Scheme);
        <div class="d-flex align-items-center gap-2 flex-wrap accounting-share-row">
            <input type="text" id="accountingShareLink" class="form-control form-control-sm" value="@reportUrl" readonly onclick="this.select();" />
            <button type="button" id="copyLinkBtn" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" title="Copy link">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span id="copyLinkBtnLabel">Copy</span>
            </button>
            <button type="button" id="shareLinkBtn" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" title="Send link">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                    <circle cx="18" cy="5" r="3"></circle>
                    <circle cx="6" cy="12" r="3"></circle>
                    <circle cx="18" cy="19" r="3"></circle>
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                </svg>
                <span>Send</span>
            </button>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var linkInput = document.getElementById('accountingShareLink');
            var copyBtn = document.getElementById('copyLinkBtn');
            var copyBtnLabel = document.getElementById('copyLinkBtnLabel');
            var shareBtn = document.getElementById('shareLinkBtn');

            if (copyBtn && linkInput) {
                copyBtn.addEventListener('click', async function () {
                    try {
                        await navigator.clipboard.writeText(linkInput.value);
                    } catch (e) {
                        linkInput.select();
                        document.execCommand('copy');
                    }
                    if (copyBtnLabel) {
                        var original = copyBtnLabel.textContent;
                        copyBtnLabel.textContent = 'Copied!';
                        setTimeout(function () { copyBtnLabel.textContent = original; }, 1500);
                    }
                });
            }

            if (shareBtn && linkInput) {
                shareBtn.addEventListener('click', async function () {
                    if (navigator.share) {
                        try {
                            await navigator.share({ title: 'Accounting Report', url: linkInput.value });
                        } catch (e) {
                            // user cancelled the share sheet - nothing to do
                        }
                    } else {
                        window.location.href = 'mailto:?subject=' + encodeURIComponent('Accounting Report') + '&body=' + encodeURIComponent(linkInput.value);
                    }
                });
            }
        })();
    </script>
}
