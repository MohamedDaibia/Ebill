@using EBill.Helpers
@using EBill.Models
@model EBill.Models.LedgerCustomerDetailsViewModel
@{
    ViewData["Title"] = Model.Name + " - Ledger";
    var isAdmin = User.IsInRole(UserRoles.Admin);
}

<div class="mb-2">
    <a asp-controller="Ledger" asp-action="Index" class="show-invoices-link">&larr; Ledger</a>
</div>

@if (TempData["LedgerSuccess"] is string okMsg)
{
    <div class="alert alert-success mt-2 mb-0">@okMsg</div>
}
@if (TempData["LedgerError"] is string errMsg)
{
    <div class="alert alert-danger mt-2 mb-0">@errMsg</div>
}

<!-- Header: customer (left) + totals (top right) -->
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mt-2">
    <div class="page-heading">
        <span class="icon-badge icon-badge--green">&#128210;</span>
        <div>
            <h1 class="mb-0">@Model.Name</h1>
            <p class="text-muted mb-0">
                @Model.CustomerNumber &middot; @Model.PhoneNumber
                @if (!string.IsNullOrWhiteSpace(Model.Gstin))
                {
                    <text> &middot; GSTIN @Model.Gstin</text>
                }
            </p>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 justify-content-end">
        <div class="form-card py-2 px-3 mb-0">
            <div class="text-muted small text-uppercase">Total Balance</div>
            <div class="fs-4 fw-bold">&#8377;@MoneyFormat.Format(Model.TotalBalance)</div>
        </div>
        <div class="form-card py-2 px-3 mb-0">
            <div class="text-muted small text-uppercase">Total Credited</div>
            <div class="fs-4 fw-bold text-success">&#8377;@MoneyFormat.Format(Model.TotalCredited)</div>
        </div>
        <div class="form-card py-2 px-3 mb-0">
            <div class="text-muted small text-uppercase">Total Debited</div>
            <div class="fs-4 fw-bold text-danger">&#8377;@MoneyFormat.Format(Model.TotalDebited)</div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <!-- Left: add debit + entries -->
    <div class="col-lg-8">
        <div class="form-card">
            <h2 class="h5 mb-1">Add Debit</h2>
            <p class="text-muted">Record an amount debited against this customer, with a comment.</p>

            <form asp-controller="Ledger" asp-action="AddDebit" asp-route-id="@Model.CustomerId" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="debitAmount" class="form-label">Debit Amount (&#8377;)</label>
                        <input id="debitAmount" name="debitAmount" type="number" step="0.01" min="0.01" class="form-control text-end" placeholder="0.00" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="debitedBy" class="form-label">Debited By</label>
                        <input id="debitedBy" type="text" class="form-control" value="@Model.Name" readonly />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="payBy" class="form-label">Pay By</label>
                        <select id="payBy" name="payBy" class="form-select">
                            @foreach (var mode in PaymentModes.All)
                            {
                                <option value="@mode" selected="@(mode == PaymentModes.Cash)">@mode</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="invoiceId" class="form-label">Invoice</label>
                        <select id="invoiceId" name="invoiceId" class="form-select">
                            <option value="">No invoice</option>
                            @foreach (var inv in Model.Invoices)
                            {
                                <option value="@inv.Id">@inv.Label</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="comments" class="form-label">Comments</label>
                    <textarea id="comments" name="comments" class="form-control" rows="2" maxlength="500" placeholder="e.g. Invoice INV-00042 part payment adjustment" required></textarea>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="reset" class="btn btn-outline-secondary">Clear</button>
                    <button type="submit" class="btn btn-primary">Add Debit</button>
                </div>
            </form>
        </div>

        <div class="form-card mt-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h5 mb-0">Ledger Entries</h2>
                <span class="text-muted small">Newest first</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle invoice-list-table">
                    <thead>
                        <tr style="background-color: var(--brand-green-light);">
                            <th>Date</th>
                            <th>Invoice</th>
                            <th>Type</th>
                            <th>Comments</th>
                            <th>By</th>
                            <th>Pay By</th>
                            <th class="text-end">Credited</th>
                            <th class="text-end">Debited</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Entries.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">No ledger entries yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var e in Model.Entries)
                            {
                                <tr>
                                    <td class="text-nowrap text-muted">@e.Date.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td class="text-nowrap">@(string.IsNullOrEmpty(e.InvoiceNumber) ? "—" : e.InvoiceNumber)</td>
                                    <td>
                                        @if (e.IsDebit)
                                        {
                                            <span class="badge text-bg-danger">Debit</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success">Credit</span>
                                        }
                                    </td>
                                    <td>
                                        @* One line only; a long comment scrolls sideways inside its cell. *@
                                        <div style="max-width: 260px; overflow-x: auto; white-space: nowrap;" tabindex="0">@e.Comments</div>
                                    </td>
                                    <td class="text-nowrap">@e.By</td>
                                    <td class="text-nowrap">@(string.IsNullOrEmpty(e.PayBy) ? "—" : e.PayBy)</td>
                                    <td class="text-end text-nowrap text-success fw-semibold">@(e.Credited > 0 ? "₹" + MoneyFormat.Format(e.Credited) : "—")</td>
                                    <td class="text-end text-nowrap text-danger fw-semibold">@(e.Debited > 0 ? "₹" + MoneyFormat.Format(e.Debited) : "—")</td>
                                    <td class="text-end">
                                        @if (e.IsDebit)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    data-bs-toggle="modal" data-bs-target="#editDebitModal"
                                                    data-entry-id="@e.Id"
                                                    data-amount="@e.Debited.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                    data-comments="@e.Comments"
                                                    data-pay-by="@e.PayBy"
                                                    data-invoice-id="@e.InvoiceId">Edit</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Right: map + customer -->
    <div class="col-lg-4">
        <div class="form-card p-0 overflow-hidden">
            @if (!string.IsNullOrEmpty(Model.MapEmbedUrl))
            {
                <iframe title="Map of @Model.Name"
                        src="@Model.MapEmbedUrl"
                        width="100%" height="260" style="border:0; display:block;"
                        loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center text-muted bg-light" style="height:260px;">
                    No address on file, so there is no map to show.
                </div>
            }

            <div class="p-3">
                <h2 class="h5 mb-2">Address</h2>
                <p class="mb-1">@(string.IsNullOrWhiteSpace(Model.Address) ? "-" : Model.Address)</p>
                @if (!string.IsNullOrWhiteSpace(Model.District) || !string.IsNullOrWhiteSpace(Model.State))
                {
                    <p class="text-muted small mb-0">@string.Join(", ", new[] { Model.District, Model.State }.Where(x => !string.IsNullOrWhiteSpace(x)))</p>
                }

                @if (isAdmin)
                {
                    <form asp-controller="Ledger" asp-action="SaveMap" asp-route-id="@Model.CustomerId" method="post" class="mt-3">
                        <label for="mapLink" class="form-label">Map link</label>
                        <input id="mapLink" name="mapLink" type="text" class="form-control" value="@Model.SavedMapLink" placeholder="Paste a Google Maps embed link" />
                        <div class="form-text">Google Maps &gt; Share &gt; Embed a map. Leave empty to search by address.</div>
                        <button type="submit" class="btn btn-primary btn-sm mt-2">Save map</button>
                    </form>
                }

                @if (!string.IsNullOrEmpty(Model.MapOpenUrl))
                {
                    <a href="@Model.MapOpenUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm mt-2">Open in Maps</a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Edit Debit Modal -->
<div class="modal fade" id="editDebitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Ledger" asp-action="EditDebit" asp-route-id="@Model.CustomerId" method="post">
                <input type="hidden" name="entryId" id="editEntryId" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit Debit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editAmount" class="form-label">Debit Amount (&#8377;)</label>
                        <input id="editAmount" name="debitAmount" type="number" step="0.01" min="0.01" class="form-control text-end" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="editPayBy" class="form-label">Pay By</label>
                            <select id="editPayBy" name="payBy" class="form-select">
                                @foreach (var mode in PaymentModes.All)
                                {
                                    <option value="@mode">@mode</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="editInvoiceId" class="form-label">Invoice</label>
                            <select id="editInvoiceId" name="invoiceId" class="form-select">
                                <option value="">No invoice</option>
                                @foreach (var inv in Model.Invoices)
                                {
                                    <option value="@inv.Id">@inv.Label</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-0">
                        <label for="editComments" class="form-label">Comments</label>
                        <textarea id="editComments" name="comments" class="form-control" rows="2" maxlength="500" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modal = document.getElementById('editDebitModal');
            modal.addEventListener('show.bs.modal', function (event) {
                var b = event.relatedTarget;
                document.getElementById('editEntryId').value = b.getAttribute('data-entry-id');
                document.getElementById('editAmount').value = b.getAttribute('data-amount');
                document.getElementById('editComments').value = b.getAttribute('data-comments') || '';
                document.getElementById('editPayBy').value = b.getAttribute('data-pay-by') || 'Cash';
                document.getElementById('editInvoiceId').value = b.getAttribute('data-invoice-id') || '';
            });
        })();
    </script>
}
