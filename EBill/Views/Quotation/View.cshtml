@model EBill.Models.Quotation
@{
    var company = ViewData["Company"] as EBill.Models.Company;
    var customer = Model.Customer!;
    var total = Model.Products.Sum(p => p.TotalAmount);
    int? previousQuotationId = ViewData["PreviousQuotationId"] as int?;
    int? nextQuotationId = ViewData["NextQuotationId"] as int?;
    ViewData["Title"] = "Quotation";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div class="page-heading">
        <span class="icon-badge icon-badge--orange">&#128221;</span>
        <div>
            <h1 class="mb-0">Quotation</h1>
            <p class="text-muted mb-0">Quotation @Model.QuotationNumber</p>
        </div>
    </div>
    <div class="d-flex gap-3 invoice-nav-links mt-1 no-print">
        @if (previousQuotationId.HasValue)
        {
            <a asp-controller="Quotation" asp-action="View" asp-route-id="@previousQuotationId" class="invoice-nav-link">&larr; Previous</a>
        }
        else
        {
            <span class="invoice-nav-link invoice-nav-link--disabled">&larr; Previous</span>
        }
        @if (nextQuotationId.HasValue)
        {
            <a asp-controller="Quotation" asp-action="View" asp-route-id="@nextQuotationId" class="invoice-nav-link">Next &rarr;</a>
        }
        else
        {
            <span class="invoice-nav-link invoice-nav-link--disabled">Next &rarr;</span>
        }
    </div>
</div>

<div class="form-card mt-3">
    <div class="d-flex justify-content-between align-items-start gap-3 invoice-top-row">
        <div class="invoice-logo-wrap">
            @if (company is not null && !string.IsNullOrWhiteSpace(company.LogoPath))
            {
                <img src="@Url.Content(company.LogoPath)" alt="@company.CompanyName logo" style="max-height: 90px; max-width: 100%; object-fit: contain;" />
            }
        </div>
        <div class="text-end invoice-meta-wrap">
            <h5 class="mb-1">Quotation #@Model.QuotationNumber</h5>
            <p class="mb-0 text-muted">Quotation Date: @Model.Date.ToString("dd MMM yyyy")</p>
        </div>
    </div>

    <div class="row mb-4 gy-4 mt-1">
        <div class="col-md-6">
            @if (company is not null)
            {
                <h5 style="color: var(--brand-green-dark);">@company.CompanyName</h5>
                <p class="mb-0 text-muted">@company.Address</p>
                <p class="mb-0 text-muted">@company.District, @company.State, @company.Country - @company.Pincode</p>
                @if (!string.IsNullOrWhiteSpace(company.PhoneNumber))
                {
                    <p class="mb-0 text-muted">Phone: @company.PhoneNumber</p>
                }
                <p class="mb-0 text-muted">GSTIN: @company.Gstin</p>
            }
        </div>
        <div class="col-md-6 text-md-end">
            <h6 class="text-uppercase fw-bold" style="color: var(--brand-orange-dark);">Quotation For</h6>
            <p class="mb-0 fw-semibold">@customer.Name (@customer.CustomerNumber)</p>
            @if (!string.IsNullOrWhiteSpace(customer.Address))
            {
                <p class="mb-0 text-muted">@customer.Address</p>
            }
            @if (!string.IsNullOrWhiteSpace(customer.PhoneNumber))
            {
                <p class="mb-0 text-muted">Phone: @customer.PhoneNumber</p>
            }
            @if (!string.IsNullOrWhiteSpace(customer.Gstin))
            {
                <p class="mb-0 text-muted">GSTIN: @customer.Gstin</p>
            }
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle invoice-items-table">
            <thead>
                <tr style="background-color: var(--brand-green-light);">
                    <th>#</th>
                    <th>Description</th>
                    <th>HSN/SAC</th>
                    <th class="text-end">Qty</th>
                    <th>Qty Type</th>
                    <th class="text-end">Rate (&#8377;)</th>
                    <th class="text-end">Discount (&#8377;)</th>
                    <th class="text-end">Amount (&#8377;)</th>
                </tr>
            </thead>
            <tbody>
                @{ var rowNum = 1; }
                @foreach (var product in Model.Products.OrderBy(p => p.Id))
                {
                    <tr>
                        <td>@rowNum</td>
                        <td>@product.Description</td>
                        <td>@product.HsnSac</td>
                        <td class="text-end">@product.Qty</td>
                        <td>@product.QtyType</td>
                        <td class="text-end">@MoneyFormat.Format(product.Rate)</td>
                        <td class="text-end">@MoneyFormat.Format(product.Discount)</td>
                        <td class="text-end">@MoneyFormat.Format(product.TotalAmount)</td>
                    </tr>
                    rowNum++;
                }
                @if (!Model.Products.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-3">No line items added yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row justify-content-end">
        <div class="col-md-6">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr class="fw-bold border-top">
                        <td>Total</td>
                        <td class="text-end">&#8377; @MoneyFormat.Format(total)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <p class="text-muted mb-1">Amount in words:</p>
        <p class="fw-semibold">@NumberToWords.ConvertAmountToWords(total)</p>
    </div>

    <div class="mt-4 pt-3 border-top">
        <p class="mb-2 fw-semibold" style="color: #d91f1f">Not a Tax Invoice</p>
        <p class="mb-0 text-muted">
            <strong>Terms:</strong> This quotation is valid for 15 days from the date of issue. Prices and
            availability are subject to change thereafter. Taxes, if applicable, will be added at the time of billing.
        </p>
    </div>

    <div class="mt-3 text-center text-muted">
        <small>This is a computer generated quotation.</small>
    </div>
</div>

@if (Model.Invoices.Any())
{
    <div class="form-card form-card--orange mt-3 no-print">
        <h6 class="mb-2">Invoiced</h6>
        @foreach (var invoice in Model.Invoices.OrderByDescending(i => i.Id))
        {
            <div class="d-flex justify-content-between align-items-center">
                <span>Invoice @invoice.BillNumber &mdash; @invoice.Date.ToString("dd MMM yyyy")</span>
                <a asp-controller="Invoice" asp-action="View" asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-secondary">View Invoice</a>
            </div>
        }
    </div>
}

<div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2 mt-3 no-print invoice-actions">
    <a asp-controller="Product" asp-action="QuotationIndex" asp-route-quotationId="@Model.Id" class="btn btn-outline-secondary">Back to Products</a>
    <button type="button" id="printBtn" class="btn btn-outline-secondary">Print</button>
    <form id="createInvoiceForm" asp-controller="Invoice" asp-action="CreateFromQuotation" asp-route-quotationId="@Model.Id" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary w-100">Create Invoice for this Quotation</button>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const printBtn = document.getElementById('printBtn');
            if (printBtn) {
                printBtn.addEventListener('click', function () {
                    window.print();
                });
            }

            const createInvoiceForm = document.getElementById('createInvoiceForm');
            if (createInvoiceForm) {
                createInvoiceForm.addEventListener('submit', function (e) {
                    if (!confirm('Create an invoice from this quotation?')) {
                        e.preventDefault();
                        return;
                    }
                    createInvoiceForm.querySelector('button[type="submit"]').disabled = true;
                });
            }
        })();
    </script>
}
