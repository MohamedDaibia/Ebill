@model EBill.Models.Company
@{
    ViewData["Title"] = "Company Registration";
}

<div class="row">
    <div class="col-md-8">
        <div class="page-heading">
            <span class="icon-badge icon-badge--green">&#127970;</span>
            <div>
                <h1 class="mb-0">Company Registration</h1>
                <p class="text-muted mb-0">Enter your company details. These will appear on every invoice you generate.</p>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.ReturnUrl))
        {
            <div class="alert alert-info" role="alert">
                Register your company to connect your Ebill account.
            </div>
        }
        <div class="form-card mt-3">
            @await Html.PartialAsync("_CompanyRegisterForm", Model)
            <p class="mt-3 mb-0">
                Already registered?
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Login here</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
